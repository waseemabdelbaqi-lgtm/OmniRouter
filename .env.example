# Copy to .env and fill in real values. Never commit .env.

# Provider keys used by the OmniRouter server
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
TOGETHER_API_KEY=your-together-api-key
STABILITY_API_KEY=your-stability-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key  # only needed if the DeepSeek provider is re-enabled

# Firebase service-account key file (download from the Firebase console; keep it out of git)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Per-user lifetime token limit (raise for Claude Code usage)
OMNI_MAX_TOKENS=100000

# Upstream for /v1/messages (defaults to https://api.anthropic.com)
# OMNI_ANTHROPIC_UPSTREAM_URL=https://api.anthropic.com

# OmniRouter API key used by the live test suite (testLib/test_core.py and tests built on it)
OMNI_TEST_API_KEY=your-omnirouter-test-key
